+--- a/src/nanobrag_torch/simulator.py
++++ b/src/nanobrag_torch/simulator.py
+@@ -293,17 +293,26 @@ def compute_physics_for_position(
+ 
+     if shape == CrystalShape.SQUARE:
+         # Compute fractional offsets from reflection centers (h-h0, k-k0, l-l0)
+-        # to avoid sincg collapse at integer Miller indices. Keep in native dtype.
+-        delta_h = h - h0
+-        delta_k = k - k0
+-        delta_l = l - l0
+-
+-        # Evaluate sincg on fractional offsets. The sincg function internally handles
+-        # precision via special-case logic for small/integer arguments.
+-        F_latt_a = sincg(torch.pi * delta_h, Na)
+-        F_latt_b = sincg(torch.pi * delta_k, Nb)
+-        F_latt_c = sincg(torch.pi * delta_l, Nc)
+-        F_latt = F_latt_a * F_latt_b * F_latt_c
++        # in float64 to avoid sincg collapse at integer Miller indices.
++        # ARCH-SIM-CONSTRUCTION-001: Upcast deltas to float64 before sincg evaluation
++        # to preserve the Na·Nb·Nc scaling near integer HKLs (SIM-CONSTR-PARTIALITY-001).
++        delta_h = (h - h0).to(torch.float64)
++        delta_k = (k - k0).to(torch.float64)
++        delta_l = (l - l0).to(torch.float64)
++
++        # Evaluate sincg on fractional offsets in float64. The sincg function returns
++        # values proportional to N when the fractional offset is tiny.
++        # Convert Na, Nb, Nc to tensors on the correct device for sincg.
++        Na_tensor = torch.tensor(Na, dtype=torch.float64, device=delta_h.device)
++        Nb_tensor = torch.tensor(Nb, dtype=torch.float64, device=delta_k.device)
++        Nc_tensor = torch.tensor(Nc, dtype=torch.float64, device=delta_l.device)
++
++        F_latt_a = sincg(torch.pi * delta_h, Na_tensor)
++        F_latt_b = sincg(torch.pi * delta_k, Nb_tensor)
++        F_latt_c = sincg(torch.pi * delta_l, Nc_tensor)
++
++        # Downcast final F_latt product back to simulator dtype before combining with F_cell
++        F_latt = (F_latt_a * F_latt_b * F_latt_c).to(h.dtype)
+     elif shape == CrystalShape.ROUND:
+         h_frac = h - h0
+         k_frac = k - k0
